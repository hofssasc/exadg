# Generated by CMake into the build tree; do not edit the copy under build/python.
# The source template lives at python/pyproject.toml.in.
[build-system]
requires = ["setuptools>=64"]
build-backend = "setuptools.build_meta"

[project]
name = "exadg"
version = "@EXADG_PYTHON_VERSION@"
description = "Python bindings for ExaDG"
requires-python = ">=3.9"
dependencies = ["numpy"]

# The online reduced model reads its operators from HDF5; the offline stage additionally needs
# pyMOR. Kept optional so that installing the bindings does not drag in a reduction framework.
[project.optional-dependencies]
mor = ["h5py"]
offline = ["h5py", "pymor>=2024.1"]

[tool.setuptools]
# The extension modules are produced by CMake and already staged in this directory, so
# setuptools only has to package what is here rather than compile anything itself.
packages = ["exadg", "exadg.mor"]
include-package-data = true

[tool.setuptools.package-data]
exadg = ["*.so", "*.pyd", "*.dylib"]
