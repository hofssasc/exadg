# Generated by CMake into the build tree; do not edit the copy under build/python.
# The source template lives at python/pyproject.toml.in.
[build-system]
requires = ["setuptools>=64"]
build-backend = "setuptools.build_meta"

[project]
name = "exadg"
version = "@EXADG_PYTHON_VERSION@"
description = "Python bindings for ExaDG"
requires-python = ">=3.9"
dependencies = ["numpy"]

# pyMOR is optional so that installing the bindings does not drag in a reduction framework:
# `exadg.thermal_block` is usable on its own as a full-order model. mpi4py is needed only to run
# the reduction on more than one rank, and must be built against the same MPI as ExaDG.
[project.optional-dependencies]
mor = ["pymor>=2025.1"]
mpi = ["pymor>=2025.1", "mpi4py"]

[tool.setuptools]
# The extension modules are produced by CMake and already staged in this directory, so
# setuptools only has to package what is here rather than compile anything itself.
packages = ["exadg", "exadg.mor"]
include-package-data = true

[tool.setuptools.package-data]
exadg = ["*.so", "*.pyd", "*.dylib"]
